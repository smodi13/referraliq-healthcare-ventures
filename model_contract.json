  "formulas": {
    "pilot_effective_cases_per_month": "pilot_monthly_cases * eligible_share * completion_rate * ramp_mN",
    "pilot_capacity_value": "sum(effective_cases_month * net_minutes_saved/60 * loaded_hourly_cost)",
    "pilot_cash_savings": "pilot_capacity_value * cash_realization",
    "pilot_net_cash": "pilot_cash_savings - (pilot_vendor_monthly+pilot_support_monthly+pilot_audit_monthly)*3 - pilot_setup",
    "scale_runrate_capacity_value": "scale_monthly_cases*12*eligible_share*completion_rate*net_minutes_saved/60*loaded_hourly_cost",
    "scale_runrate_cash_savings": "scale_runrate_capacity_value*cash_realization",
    "scale_recurring_cost": "12*(scale_vendor_monthly+scale_support_monthly+scale_audit_monthly)",
    "scale_runrate_net_cash": "scale_runrate_cash_savings-scale_recurring_cost",
    "scale_first_year_net_cash": "scale_runrate_cash_savings*first_year_ramp-scale_recurring_cost-scale_rollout_setup",
    "equity_ownership_initial": "investor_check_m/(exit_premoney_m+round_raise_m)",
    "exit_proceeds_m": "exit_arr_m*exit_rev_multiple*equity_value_factor*equity_ownership_initial*(1-ownership_dilution)",
    "venture_moic": "exit_proceeds_m/investor_check_m",
    "venture_irr": "venture_moic**(1/hold_years)-1"
  }
}